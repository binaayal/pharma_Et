# Local development. Copy to .env — .env is git-ignored and must never be committed.

NODE_ENV=development
PORT=3000

# scripts/dev-db.sh runs PostgreSQL on 5433 so it cannot collide with a host install.
DATABASE_URL=postgres://pharmaet:pharmaet_dev_password@localhost:5433/pharmaet_dev
# Connections in the tenant pool. Every sync write holds one for its transaction (NFR-3.1).
DB_POOL_MAX=20
# The regulated half (ADR-024). Leave OFF in every deployed environment until A-1 is
# verified and recorded in docs/compliance-sign-off.md.
CONTROLLED_DISPENSING=off

# The application connects as a NON-superuser role so RLS is actually enforced:
# Postgres exempts superusers and table owners from row-level security, which would make
# the isolation backstop silently inert (ADR-003, ADR-007).
DATABASE_APP_USER=pharmaet_app
DATABASE_APP_PASSWORD=pharmaet_app_dev_password

# Dev-only secret. Production secrets live in the managed secret store, never here.
JWT_SECRET=dev-only-insecure-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# How long a terminal may authenticate against its cached PIN verifier before privileged
# actions require online re-auth. 72h guaranteed window (NFR-1.1) + margin.
OFFLINE_AUTH_TTL_HOURS=168

CORS_ORIGINS=http://localhost:5173
