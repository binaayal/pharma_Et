{
  "name": "@pharmaet/api",
  "version": "0.1.0",
  "private": true,
  "description": "PharmaEt backend — NestJS modular monolith over PostgreSQL with RLS",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --config jest.config.cjs --selectProjects unit",
    "test:integration": "jest --config jest.config.cjs --selectProjects integration --runInBand",
    "test:guardian": "jest --config jest.config.cjs --selectProjects guardian --runInBand",
    "test:cov": "jest --config jest.config.cjs --coverage",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/data-source.ts",
    "migration:run": "pnpm typeorm migration:run",
    "migration:revert": "pnpm typeorm migration:revert",
    "migration:generate": "pnpm typeorm migration:generate",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "predev": "pnpm --filter @pharmaet/contracts build",
    "prebuild": "pnpm --filter @pharmaet/contracts build",
    "pretypecheck": "pnpm --filter @pharmaet/contracts build",
    "pretest": "pnpm --filter @pharmaet/contracts build",
    "typeorm:prod": "typeorm -d dist/config/data-source.js",
    "migration:run:prod": "pnpm typeorm:prod migration:run",
    "seed:prod": "node dist/seed.js",
    "test:e2e": "jest --config jest.config.cjs --selectProjects e2e --runInBand",
    "test:perf": "jest --config jest.config.cjs --selectProjects perf --runInBand"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.22",
    "@nestjs/typeorm": "^10.0.2",
    "@pharmaet/contracts": "workspace:*",
    "@types/multer": "^2.2.0",
    "argon2": "^0.41.1",
    "dotenv": "^18.0.3",
    "express": "^4.22.1",
    "multer": ">=2.3.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20",
    "uuidv7": "^1.0.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.7.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^8.57.1",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.6.3"
  }
}
