{
  "name": "@pharmaet/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Single source of truth for the sync envelope and shared API contract (ADR-010)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "generate": "tsx src/codegen/generate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"(contracts: lint covered by typecheck)\"",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.2",
    "zod-to-json-schema": "^3.23.3"
  }
}
